{
	"info": {
		"_postman_id": "tdc-matchmaker-api",
		"name": "The Date Crew - Matchmaker API",
		"description": "Complete backend API for The Date Crew Matchmaker MVP. Includes auth, customers, and AI-powered matching endpoints. Tested and ready for use!",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "tdc-team"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Login - Priya (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"priya\",\n    \"password\": \"tdc123\"\n}"
						},
						"url": {
							"raw": "https://tdc-assignment-backend.onrender.com/api/auth/login",
							"protocol": "https",
							"host": [
								"tdc-assignment-backend",
								"onrender",
								"com"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Login as Priya (demo admin user). Save the JWT token for authenticated requests!"
					},
					"response": []
				},
				{
					"name": "Login - Ananya (Manager)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"ananya\",\n    \"password\": \"tdc456\"\n}"
						},
						"url": {
							"raw": "http://localhost:5000/api/auth/login",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Login as Ananya (demo manager user)"
					},
					"response": []
				},
				{
					"name": "Register New User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Rahul Sharma\",\n    \"username\": \"rahul\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "http://localhost:5000/api/auth/register",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Register a new matchmaker user"
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Customers",
			"item": [
				{
					"name": "Get All Customers",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:5000/api/customers",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"customers"
							]
						},
						"description": "Fetch all customer profiles. Includes transformed data like age and mapped stage/status"
					},
					"response": []
				},
				{
					"name": "Get Customer by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:5000/api/customers/:customerId",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"customers",
								":customerId"
							],
							"variable": [
								{
									"key": "customerId",
									"value": "ENTER_A_CUSTOMER_ID_HERE",
									"description": "Get from Get All Customers endpoint"
								}
							]
						},
						"description": "Fetch a single customer profile by MongoDB Object ID"
					},
					"response": []
				},
				{
					"name": "Update Customer (Stage/Marital Status)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"stage\": \"Verified\",\n    \"maritalStatus\": \"Divorced\"\n}"
						},
						"url": {
							"raw": "http://localhost:5000/api/customers/:customerId",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"customers",
								":customerId"
							],
							"variable": [
								{
									"key": "customerId",
									"value": "ENTER_A_CUSTOMER_ID_HERE",
									"description": "Get from Get All Customers"
								}
							]
						},
						"description": "Update any customer field. Supports mapping of 'stage' (frontend) to 'status' (backend)"
					},
					"response": []
				},
				{
					"name": "Update Customer Notes",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"notes\": \"Great profile, looking for someone from similar background\"\n}"
						},
						"url": {
							"raw": "http://localhost:5000/api/customers/:customerId/notes",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"customers",
								":customerId",
								"notes"
							],
							"variable": [
								{
									"key": "customerId",
									"value": "ENTER_A_CUSTOMER_ID_HERE"
								}
							]
						},
						"description": "Update only the notes field of a customer"
					},
					"response": []
				}
			]
		},
		{
			"name": "3. AI-Powered Matching",
			"item": [
				{
					"name": "Get Algorithmic + AI Matches",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:5000/api/matches/:customerId",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"matches",
								":customerId"
							],
							"variable": [
								{
									"key": "customerId",
									"value": "ENTER_A_CUSTOMER_ID_HERE",
									"description": "Requires a customer with gender Male/Female for good AI matching"
								}
							]
						},
						"description": "Get algorithmic pre-filtered matches, then scored/ranked by GEMINI AI. Returns compatibility scores, detailed reasoning, and personalized email intros!"
					},
					"response": []
				},
				{
					"name": "Send Match",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"fromCustomerId\": \"FROM_CUSTOMER_ID\",\n    \"toCustomerId\": \"TO_CUSTOMER_ID\",\n    \"score\": 85,\n    \"reason\": \"High Potential Match based on AI analysis\"\n}"
						},
						"url": {
							"raw": "http://localhost:5000/api/matches/send",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"matches",
								"send"
							]
						},
						"description": "Mock trigger to send a match. Updates history and status of both profiles, returns success toast notification data for frontend"
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:5000/",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5000"
				},
				"description": "Simple health check to verify the server is running"
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000",
			"type": "string"
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	]
}
